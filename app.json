{
  "expo": {
    "name": "cargo-tracker",
    "slug": "cargo-tracker",
    "scheme": "cargotracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/company-icons/kargo-takip-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.omer.cargotracker",
      "supportsTablet": true
    },
    "android": {
      "package": "com.omer.cargotracker",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./src/assets/company-icons/kargo-takip-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "KargoTakip kilit ekranını açmak için Face ID doğrulaması kullanılır."
        }
      ]
    ]
  }
}
