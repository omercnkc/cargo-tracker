{
  "expo": {
    "name": "cargo-tracker",
    "slug": "cargo-tracker",
    "scheme": "cargotracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00236f"
    },
    "ios": {
      "bundleIdentifier": "com.omer.cargotracker",
      "supportsTablet": true
    },
    "android": {
      "package": "com.omer.cargotracker",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#00236f",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#00236f"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "KargoTakip kilit ekranını açmak için Face ID doğrulaması kullanılır."
        }
      ],
      "expo-sqlite"
    ]
  }
}