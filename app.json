{
  "expo": {
    "name": "cargo-tracker",
    "slug": "cargo-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.omer.cargotracker",
      "supportsTablet": true
    },
    "android": {
      "package": "com.omer.cargotracker",
      "adaptiveIcon": {
        "backgroundColor": "#001b9e",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
