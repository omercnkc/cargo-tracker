# Supabase Edge Functions için Ortam Değişkenleri (.env)
# Bu anahtarları Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets kısmından tanımlayabilirsiniz:
# Veya CLI ile: npx supabase secrets set ARAS_API_KEY="..."

# 1. Aras Kargo
ARAS_API_KEY="... ARAS KARGO API KEY / ŞİFRENİZİ GİRİNİZ ..."
ARAS_CUSTOMER_CODE="... ARAS MÜŞTERİ KODUNUZU GİRİNİZ ..."

# 2. Yurtiçi Kargo
YURTICI_API_KEY="... YURTİÇİ KARGO API KEY / TOKEN GİRİNİZ ..."
YURTICI_USER="... YURTİÇİ KULLANICI ADI GİRİNİZ ..."

# 3. MNG Kargo
MNG_API_KEY="... MNG KARGO API KEY GİRİNİZ ..."
MNG_CUSTOMER_NUMBER="... MNG MÜŞTERİ NO GİRİNİZ ..."

# 4. Trendyol Express
TRENDYOL_API_KEY="... TRENDYOL EXPRESS API KEY GİRİNİZ ..."

# 5. Genel Kargo Takip Servisi (Opsiyonel: 17Track, AfterShip veya ShipEntegra)
CARRIER_TRACKING_API_KEY="... GENEL TAKİP SERVİSİ API KEY GİRİNİZ ..."
